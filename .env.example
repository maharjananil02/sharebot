# NEPSE TMS Configuration
NEPSE_USERNAME=your_username
NEPSE_PASSWORD=your_password
NEPSE_LOGIN_URL=https://tms17.nepsetms.com.np/login

# Browser Configuration
HEADLESS_MODE=False
IMPLICIT_WAIT=10

# Trading Configuration
TRADING_ENABLED=False
DEMO_MODE=True
LOG_LEVEL=INFO
BOT_CHECK_INTERVAL_SECONDS=30
# Market time should be Nepal time on the server.
MARKET_TIMEZONE=Asia/Kathmandu

# Use Supabase/Postgres for persistent position storage on Streamlit Cloud.
# Copy the URI from Supabase → Project Settings → Database → Connection string (URI)
# Example format for your project:
# postgresql://postgres:<url-encoded-password>@db.pputdnuadbjwwhbscbvw.supabase.co:5432/postgres?sslmode=require
# For Streamlit Cloud, set this in Secrets / app variables.
# Replace with your actual Supabase/Postgres connection string. Make sure the
# password portion is URL-encoded (e.g. '#' -> '%23'). Also include
# `?sslmode=require` for many hosted Postgres providers.
# Example (password '#' encoded as '%23'):
POSITIONS_DB_URL=postgresql://postgres:%C7d7E%23c.%Vbceb@db.pputdnuadbjwwhbscbvw.supabase.co:5432/postgres?sslmode=require
# Local SQLite fallback for development only (use a persistent disk on your own server)
POSITIONS_DB_PATH=data/nepse_positions.db
# Legacy JSON directory (kept only for migration)
POSITIONS_DIR=data/positions

# Email Notification Configuration
# Example for Gmail SMTP:
# EMAIL_SMTP=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_TO=recipient_email@gmail.com
EMAIL_SMTP=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

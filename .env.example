# NEPSE TMS Configuration
NEPSE_USERNAME=your_username
NEPSE_PASSWORD=your_password
NEPSE_LOGIN_URL=https://tms17.nepsetms.com.np/login

# Browser Configuration
HEADLESS_MODE=False
IMPLICIT_WAIT=10

# Trading Configuration
TRADING_ENABLED=False
DEMO_MODE=True
LOG_LEVEL=INFO
BOT_CHECK_INTERVAL_SECONDS=30
# Market Configuration
# NEPSE market timezone
MARKET_TIMEZONE=Asia/Kathmandu

# Market session: continuous from 11:00 AM to 3:00 PM (no breaks)
MARKET_OPEN_HOUR=11
MARKET_OPEN_MIN=0
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MIN=0

# Positions storage (SQLite database)
# Use ABSOLUTE PATH in a directory the app user can write to
# IMPORTANT: If running on a server, use a path owned by the Streamlit runtime user
# Examples:
#   Production (Streamlit Cloud or similar): /tmp/nepse-trading/data/positions.db or /home/appuser/nepse-trading/data/positions.db
#   Self-hosted: /opt/nepse-trading/data/positions.db (ensure directory is writable by the app user)
#   Local dev: ./data/positions.db or /Users/anil/Coding/lets\ code/nepse-trading/data/positions.db
POSITIONS_DB_PATH=./data/positions.db

# Trade history storage (SQLite database)
# Use same directory as positions for consistency
TRADES_DB_PATH=./data/trades.db

# Email Notification Configuration
# Example for Gmail SMTP:
# EMAIL_SMTP=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_TO=recipient_email@gmail.com
EMAIL_SMTP=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

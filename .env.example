# NEPSE TMS Configuration
NEPSE_USERNAME=your_username
NEPSE_PASSWORD=your_password
NEPSE_LOGIN_URL=https://tms17.nepsetms.com.np/login

# Browser Configuration
HEADLESS_MODE=False
IMPLICIT_WAIT=10

# Trading Configuration
TRADING_ENABLED=False
DEMO_MODE=True
LOG_LEVEL=INFO
BOT_CHECK_INTERVAL_SECONDS=30
# Market time should be Nepal time on the server.
MARKET_TIMEZONE=Asia/Kathmandu

# Positions storage (simple file-based JSON in `logs/` by default)
# Positions are saved as `logs/<symbol>_position.json`.
# To override the directory set `POSITIONS_DIR` in your environment or Secrets.
POSITIONS_DIR=logs

# Email Notification Configuration
# Example for Gmail SMTP:
# EMAIL_SMTP=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_TO=recipient_email@gmail.com
EMAIL_SMTP=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

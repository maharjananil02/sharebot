# NEPSE TMS Configuration
NEPSE_USERNAME=your_username
NEPSE_PASSWORD=your_password
NEPSE_LOGIN_URL=https://tms17.nepsetms.com.np/login

# Browser Configuration
HEADLESS_MODE=False
IMPLICIT_WAIT=10

# Trading Configuration
TRADING_ENABLED=False
DEMO_MODE=True
LOG_LEVEL=INFO
BOT_CHECK_INTERVAL_SECONDS=30
# Market Configuration
# NEPSE market timezone
MARKET_TIMEZONE=Asia/Kathmandu

# Market session: continuous from 11:00 AM to 3:00 PM (no breaks)
MARKET_OPEN_HOUR=11
MARKET_OPEN_MIN=0
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MIN=0

# Positions storage (SQLite database)
# IMPORTANT: Streamlit Cloud / Docker environments
#   - /mount/src/ paths are EPHEMERAL (wiped on restart) ❌
#   - Use ~/.streamlit/ for more persistence, or better yet: external database
#
# For Streamlit Cloud / ephemeral environments:
#   Best: Use Supabase/Firebase/PostgreSQL (see DEPLOY.md)
#   Fallback: POSITIONS_DB_PATH=~/.streamlit/positions.db (may survive some restarts)
#
# For self-hosted servers:
#   Use absolute path: /home/appuser/nepse-trading/data/positions.db
#   Or relative to repo: ./data/positions.db (if /repo is persistent)
#
# Default tries ~/.streamlit first, then falls back to ./data/
POSITIONS_DB_PATH=~/.streamlit/positions.db

# Trade history storage (SQLite database)
TRADES_DB_PATH=~/.streamlit/trades.db

# Email Notification Configuration
# Example for Gmail SMTP:
# EMAIL_SMTP=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_TO=recipient_email@gmail.com
EMAIL_SMTP=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
